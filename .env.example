# Copia estas variables en Vercel → Project → Settings → Environment Variables.
# Si una falta, la sección correspondiente se oculta o usa el respaldo; el sitio nunca se rompe.

# Banxico SIE (gratis): https://www.banxico.org.mx/SieAPIRest/service/v1/token
# Da el tipo de cambio FIX oficial y la tasa objetivo. Sin él, el tipo de cambio sale de Frankfurter (BCE).
BANXICO_TOKEN=

# Financial Modeling Prep: https://site.financialmodelingprep.com/developer/docs
# Da el feed de transacciones M&A recientes (anuncios ante la SEC, EE.UU.).
FMP_API_KEY=

# Formulario de contacto (Resend, plan gratuito): https://resend.com/api-keys
# Sin estas dos variables el formulario muestra "no disponible" y no envía nada.
RESEND_API_KEY=
# Correo(s) que reciben los mensajes, separados por coma. No se muestra en la página.
CONTACT_TO=
# Opcional: remitente con dominio verificado en Resend (p. ej. "Grupo Platino <web@gplatino.com>")
CONTACT_FROM=
